@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject StayHub.Core.Interfaces.INotificationRepository NotificationRepo
@inject StayHub.Core.Interfaces.IMessageRepository MessageRepo

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var unread = currentUser is null ? 0 : await NotificationRepo.GetUnreadCountAsync(currentUser.Id);
    var unreadMessages = currentUser is null ? 0 : await MessageRepo.GetUnreadCountAsync(currentUser.Id);
    var searchCity = Context.Request.Query["city"].ToString();
    var searchType = Context.Request.Query["type"].ToString();
    var accountInitial = currentUser?.FirstName.FirstOrDefault().ToString().ToUpperInvariant() ?? "U";
    var accountRole = User.IsInRole(Roles.SuperAdmin) ? "Super Admin"
        : User.IsInRole(Roles.Admin) ? "Administrator"
        : User.IsInRole(Roles.Host) ? "Host"
        : User.IsInRole(Roles.Guest) ? "Guest"
        : "Member";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; StayHub</title>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0e6ba8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fuzzy+Bubbles:wght@400;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/stayhub.css" asp-append-version="true" />
</head>
<body>
    <header class="sh-header">
        <div class="container d-flex align-items-center justify-content-between gap-3 py-3">
            <a class="sh-brand" asp-controller="Home" asp-action="Index">
                <img class="sh-brand-mark" src="~/images/brand/stayhub-mark.svg" alt="" aria-hidden="true" />
                <span class="fuzzy-bubbles-bold">StayHub</span>
            </a>

            <form class="sh-searchbar d-none d-lg-flex" asp-controller="Properties" asp-action="Index" method="get" role="search">
                <label class="sh-searchbar-field">
                    <span>Where</span>
                    <input name="city" placeholder="Anywhere" value="@searchCity" autocomplete="off" aria-label="City" />
                </label>
                <span class="sh-searchbar-divider"></span>
                <label class="sh-searchbar-field">
                    <span>Stay type</span>
                    <select name="type" aria-label="Property type">
                        <option value="">Any Type</option>
                        @foreach (PropertyType type in Enum.GetValues<PropertyType>())
                        {
                            <option value="@type" selected="@(type.ToString() == searchType)">@type</option>
                        }
                    </select>
                </label>
                <button class="sh-searchbar-btn" type="submit" aria-label="Search stays">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M20 20l-3.5-3.5" />
                    </svg>
                </button>
            </form>

            <nav class="d-flex align-items-center gap-2">
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="sh-navlink sh-navicon" asp-controller="Notifications" asp-action="Index" title="Notifications" aria-label="Notifications">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
                            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                        </svg>
                        <span class="sh-badge" id="shNotifBadge" @(unread > 0 ? null : "hidden")>@unread</span>
                    </a>

                    <a class="sh-navlink sh-navicon" asp-controller="Messages" asp-action="Index" title="Messages" aria-label="Messages">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="5" width="18" height="14" rx="2" />
                            <path d="m3 7 9 6 9-6" />
                        </svg>
                        <span class="sh-badge" id="shMessageBadge" @(unreadMessages > 0 ? null : "hidden")>@unreadMessages</span>
                    </a>

                    <div class="dropdown">
                        <button class="sh-account-chip dropdown-toggle"
                                data-bs-toggle="dropdown"
                                type="button"
                                aria-label="Account menu"
                                aria-expanded="false">
                            <span class="sh-account-chip-avatar" aria-hidden="true">@accountInitial</span>
                            <span class="sh-account-chip-meta">
                                <span class="sh-account-chip-name">@currentUser?.FullName</span>
                                <span class="sh-account-chip-role">@accountRole</span>
                            </span>
                            <span class="sh-account-chip-caret" aria-hidden="true"></span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end sh-menu">
                            <li class="px-2 py-1">
                                <div class="fw-bold small">@currentUser?.FullName</div>
                                <div class="small text-muted">@currentUser?.Email</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            @if (User.IsInRole(Roles.Guest))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Bookings" asp-action="Index">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"calendar"' /><span>My Trips</span></span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Wishlist" asp-action="Index">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"heart"' /><span>Wishlist</span></span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HostApplications" asp-action="Apply">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"home"' /><span>Become a Host</span></span>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="HostApplications" asp-action="Status">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"document"' /><span>Application Status</span></span>
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(Roles.Host))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Host" asp-action="Dashboard">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"dashboard"' /><span>Host Dashboard</span></span>
                                    </a>
                                </li>
                            }
                            else if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SuperAdmin))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"dashboard"' /><span>Admin Dashboard</span></span>
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item" asp-controller="Messages" asp-action="Index">
                                    <span class="sh-menu-label"><partial name="_Icon" model='"mail"' /><span>Inbox</span></span>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Notifications" asp-action="Index">
                                    <span class="sh-menu-label"><partial name="_Icon" model='"bell"' /><span>Notifications</span></span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="dropdown-item text-danger" type="submit">
                                        <span class="sh-menu-label"><partial name="_Icon" model='"logout"' /><span>Log Out</span></span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="sh-navlink" asp-controller="Account" asp-action="Login">Log In</a>
                    <a class="sh-btn sh-btn-sun sh-btn-sm" asp-controller="Account" asp-action="Register">Sign Up</a>
                }
            </nav>
        </div>
    </header>

    <main class="container py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }

        @RenderBody()
    </main>

    <footer class="sh-footer">
        <div class="container">
            <div class="sh-footer-promo">
                <div class="sh-footer-promo-inner">
                    <p class="sh-footer-promo-copy">Find a stay, or open your doors.</p>
                    <div class="sh-footer-promo-actions">
                        <a class="sh-btn sh-btn-ghost" asp-controller="Properties" asp-action="Index">Browse stays</a>
                        <a class="sh-btn sh-btn-sun" asp-controller="HostApplications" asp-action="Apply">Become a host</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="sh-footer-main">
            <div class="container">
                <div class="sh-footer-grid">
                    <div class="sh-footer-brand-block">
                        <a class="sh-footer-brand" asp-controller="Home" asp-action="Index">
                            <img class="sh-brand-mark" src="~/images/brand/stayhub-mark-light.svg" alt="" aria-hidden="true" />
                            <span class="fuzzy-bubbles-bold">StayHub</span>
                        </a>
                    </div>

                    <nav class="sh-footer-col" aria-label="Explore">
                        <span class="sh-footer-heading">Explore</span>
                        <a asp-controller="Home" asp-action="Index">Home</a>
                        <a asp-controller="Properties" asp-action="Index">Browse Properties</a>
                        <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                        <a asp-controller="Home" asp-action="Terms">Terms of Service</a>
                        <a asp-controller="Home" asp-action="Cookies">Cookie Policy</a>
                    </nav>

                    <nav class="sh-footer-col" aria-label="Hosting">
                        <span class="sh-footer-heading">Hosting</span>
                        <a asp-controller="HostApplications" asp-action="Apply">Become a Host</a>
                        <a asp-controller="HostApplications" asp-action="Status">Application Status</a>
                    </nav>

                    <nav class="sh-footer-col" aria-label="Guest">
                        <span class="sh-footer-heading">Guest</span>
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <a asp-controller="Account" asp-action="Register">Sign Up</a>
                            <a asp-controller="Account" asp-action="Login">Log In</a>
                        }
                        <a asp-controller="Bookings" asp-action="Index">My Trips</a>
                        <a asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                    </nav>

                    <div class="sh-footer-newsletter">
                        <span class="sh-footer-heading">Newsletter</span>
                        <p class="sh-footer-newsletter-copy">
                            Occasional stay tips and new listings across South Africa.
                        </p>
                        <form class="sh-footer-newsletter-form"
                              asp-controller="Home"
                              asp-action="Subscribe"
                              method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                            <label class="visually-hidden" for="footer-newsletter-email">Email</label>
                            <input id="footer-newsletter-email"
                                   class="sh-footer-newsletter-input"
                                   name="Email"
                                   type="email"
                                   required
                                   maxlength="256"
                                   placeholder="you@email.com"
                                   autocomplete="email" />
                            <button type="submit" class="sh-btn sh-btn-sun sh-btn-sm">Subscribe</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="sh-footer-bar">
            <div class="container sh-footer-bar-inner">
                <span>&copy; @DateTime.Now.Year StayHub</span>
                <span>Prices shown in South African Rand (ZAR)</span>
            </div>
        </div>
    </footer>

    <partial name="_ConfirmModal" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (SignInManager.IsSignedIn(User))
    {
        <partial name="_RealtimeClient" />
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
