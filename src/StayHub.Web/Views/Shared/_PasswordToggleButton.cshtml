<button type="button"
        class="sh-password-toggle"
        data-sh-password-toggle
        aria-label="Show password"
        aria-pressed="false">
    <span data-sh-password-icon="show"><partial name="_Icon" model='"eye"' /></span>
    <span data-sh-password-icon="hide" hidden><partial name="_Icon" model='"eyeoff"' /></span>
</button>
