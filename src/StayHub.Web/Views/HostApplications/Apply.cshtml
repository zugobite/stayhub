@model HostApplicationViewModel
@{
    ViewData["Title"] = "Become a Host";
}

<h1 class="sh-section-title">Become a Host</h1>
<p class="text-muted">
    Tell us about your place. An application cannot be submitted without at least one photo -
    an administrator reviews every submission before the listing goes live.
</p>

<form asp-action="Apply" method="post" enctype="multipart/form-data" class="sh-formcard">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Lovely City Apartment" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <label asp-for="PricePerNight" class="form-label"></label>
            <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="PricePerNight" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CleaningFee" class="form-label"></label>
            <input asp-for="CleaningFee" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="CleaningFee" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PropertyType" class="form-label"></label>
            <select asp-for="PropertyType" class="form-select" asp-items="Html.GetEnumSelectList<PropertyType>()"></select>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <label asp-for="MaxGuests" class="form-label"></label>
            <input asp-for="MaxGuests" class="form-control" type="number" min="1" />
        </div>
        <div class="col-md-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-3">
            <label asp-for="Beds" class="form-label"></label>
            <input asp-for="Beds" class="form-control" type="number" min="0" />
        </div>
        <div class="col-md-3">
            <label asp-for="Bathrooms" class="form-label"></label>
            <input asp-for="Bathrooms" class="form-control" type="number" min="0" />
        </div>
    </div>

    <div class="mt-4">
        <label asp-for="Images" class="form-label"></label>
        <input asp-for="Images" class="form-control" type="file" multiple accept="image/*" />
        <div class="form-text">At least one photo is required. JPG, PNG, WEBP, or GIF up to 5 MB each.</div>
        <span asp-validation-for="Images" class="text-danger"></span>
    </div>

    <button class="sh-btn sh-btn-primary mt-4" type="submit">Submit application</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
