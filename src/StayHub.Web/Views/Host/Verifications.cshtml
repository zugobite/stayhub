@model IEnumerable<GuestCheckIn>
@{
    ViewData["Title"] = "Guest check-ins";
}

<div class="sh-shell">
    <partial name="_HostSidebar" />

    <section class="sh-shell-main">
        <h1 class="sh-section-title">Guest check-ins awaiting verification</h1>

        @if (!Model.Any())
        {
            <partial name="_EmptyState" model='new EmptyState("empty-documents", "Nothing to verify", "Identity documents uploaded by guests during check-in appear here.")' />
        }
        else
        {
            foreach (var checkIn in Model)
            {
                <div class="sh-panel">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <div>
                            <strong>@checkIn.Booking?.Guest?.FullName</strong>
                            <div class="text-muted">@checkIn.Booking?.Property?.Title &middot; booking #@checkIn.BookingId</div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(checkIn.Booking?.GuestId))
                            {
                                <a class="sh-btn sh-btn-sm sh-btn-ghost" asp-controller="Messages" asp-action="Conversation" asp-route-id="@checkIn.Booking.GuestId">
                                    Message Guest
                                </a>
                            }
                            <span class="sh-pill sh-pill-pending">@checkIn.Status</span>
                        </div>
                    </div>

                    <table class="table sh-table align-middle mt-3 mb-0">
                        <thead>
                            <tr><th>Document</th><th>Type</th><th>Uploaded</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var document in checkIn.Documents)
                            {
                                <tr>
                                    <td><a href="@document.FileUrl" target="_blank" rel="noopener">@document.FileName</a></td>
                                    <td>@document.DocumentType</td>
                                    <td>@document.UploadedAt.ToString("d MMM yyyy HH:mm")</td>
                                    <td><span class="sh-pill sh-pill-@document.Status.ToString().ToLowerInvariant()">@document.Status</span></td>
                                    <td>
                                        @{
                                            var actions = new List<ActionMenuItem>
                                            {
                                                new("View document", Icon: "external", Href: document.FileUrl, OpenInNewTab: true)
                                            };

                                            if (document.Status == DocumentStatus.Pending)
                                            {
                                                actions.Add(new ActionMenuItem(
                                                    "Verify",
                                                    Icon: "shield",
                                                    Controller: "Host",
                                                    Action: "VerifyDocument",
                                                    HiddenFields: new Dictionary<string, string>
                                                    {
                                                        ["documentId"] = document.Id.ToString(),
                                                        ["bookingId"] = checkIn.BookingId.ToString(),
                                                        ["approved"] = "true"
                                                    }));
                                                actions.Add(new ActionMenuItem(
                                                    "Reject",
                                                    Icon: "x",
                                                    Controller: "Host",
                                                    Action: "VerifyDocument",
                                                    HiddenFields: new Dictionary<string, string>
                                                    {
                                                        ["documentId"] = document.Id.ToString(),
                                                        ["bookingId"] = checkIn.BookingId.ToString(),
                                                        ["approved"] = "false"
                                                    },
                                                    Danger: true));
                                            }
                                        }
                                        <partial name="_ActionMenu" model="actions" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </section>
</div>
