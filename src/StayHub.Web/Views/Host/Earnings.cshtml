@model HostEarningsViewModel
@{
    ViewData["Title"] = "Earnings";
    var earning = new[] { BookingStatus.Paid, BookingStatus.CheckedIn, BookingStatus.Completed };
    var settled = Model.All.Where(b => earning.Contains(b.Status)).ToList();
}

<div class="sh-shell">
    <partial name="_HostSidebar" />

    <section class="sh-shell-main">
        <h1 class="sh-section-title">Earnings report</h1>

        <div class="sh-statgrid">
            <partial name="_StatCard" model='new StatCard("Settled earnings", $"R {settled.Sum(b => b.TotalPrice):N2}", $"{settled.Count} bookings", "wallet", "leaf")' />
            <partial name="_StatCard" model='new StatCard("Awaiting settlement", $"R {Model.All.Where(b => b.Status == BookingStatus.Approved).Sum(b => b.TotalPrice):N2}", "Approved, not yet paid", "calendar", "sun")' />
            <partial name="_StatCard" model='new StatCard("Average booking value", settled.Count == 0 ? "-" : $"R {settled.Average(b => b.TotalPrice):N2}", "Across settled bookings", "activity")' />
        </div>

        <div class="table-responsive mt-4">
            <table class="table sh-table align-middle">
                <thead>
                    <tr><th>Booking</th><th>Property</th><th>Guest</th><th>Dates</th><th>Status</th><th class="text-end">Amount</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Page.Items)
                    {
                        var actions = new List<ActionMenuItem>
                        {
                            new("View Property", Icon: "eye", Href: Url.Action("View", "Properties", new { id = booking.PropertyId }))
                        };

                        if (!string.IsNullOrEmpty(booking.GuestId))
                        {
                            actions.Add(new ActionMenuItem(
                                "Message Guest",
                                Icon: "mail",
                                Href: Url.Action("Conversation", "Messages", new { id = booking.GuestId })));
                        }

                        <tr>
                            <td>#@booking.Id</td>
                            <td>@booking.Property?.Title</td>
                            <td>@booking.Guest?.FullName</td>
                            <td>@booking.CheckInDate.ToString("d MMM") – @booking.CheckOutDate.ToString("d MMM yyyy")</td>
                            <td><span class="sh-pill sh-pill-@booking.Status.ToString().ToLowerInvariant()">@booking.Status</span></td>
                            <td class="text-end">R @booking.TotalPrice.ToString("N2")</td>
                            <td class="text-end"><partial name="_ActionMenu" model="actions" /></td>
                        </tr>
                    }
                </tbody>
            </table>

            <partial name="_Pagination" model='Model.Page.ToPager("bookings")' />
        </div>
    </section>
</div>
