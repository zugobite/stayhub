@model IEnumerable<Review>
@{
    ViewData["Title"] = "Reviews";
}

<div class="sh-shell">
    <partial name="_HostSidebar" />

    <section class="sh-shell-main">
        <h1 class="sh-section-title">Reviews</h1>

        @if (!Model.Any())
        {
            <partial name="_EmptyState" model='new EmptyState("empty-reviews", "No reviews yet", "Reviews guests leave across all your listings collect here.")' />
        }
        else
        {
            <p class="text-muted">Average rating: <strong>@Model.Average(r => r.Rating).ToString("0.0")</strong> across @Model.Count() reviews.</p>

            <div class="sh-reviewlist">
                @foreach (var review in Model)
                {
                    <partial name="_ReviewListItem" model="review" />
                }
            </div>
        }
    </section>
</div>
