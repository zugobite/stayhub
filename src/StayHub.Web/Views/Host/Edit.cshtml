@model EditPropertyViewModel
@{
    ViewData["Title"] = "Edit Listing";
}

<a class="sh-backlink" asp-action="Properties">&larr; My Properties</a>
<h1 class="sh-section-title">Edit Listing</h1>
<p class="text-muted">Update your listing details. New photos are optional and will be added to the gallery.</p>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="sh-formcard">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" placeholder="Lovely City Apartment" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5" placeholder="What makes this stay special?"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" placeholder="12 Long Street" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" class="form-control" placeholder="Cape Town" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <label asp-for="Province" class="form-label"></label>
            <select asp-for="Province" class="form-select" asp-items="Html.GetEnumSelectList<Province>()"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="PropertyType" class="form-label"></label>
            <select asp-for="PropertyType" class="form-select" asp-items="Html.GetEnumSelectList<PropertyType>()"></select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <label asp-for="PricePerNight" class="form-label"></label>
            <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" placeholder="850" />
            <span asp-validation-for="PricePerNight" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="CleaningFee" class="form-label"></label>
            <input asp-for="CleaningFee" class="form-control" type="number" step="0.01" placeholder="250" />
            <span asp-validation-for="CleaningFee" class="text-danger"></span>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-3">
            <label asp-for="MaxGuests" class="form-label"></label>
            <input asp-for="MaxGuests" class="form-control" type="number" min="1" placeholder="4" />
        </div>
        <div class="col-md-3">
            <label asp-for="Bedrooms" class="form-label"></label>
            <input asp-for="Bedrooms" class="form-control" type="number" min="0" placeholder="2" />
        </div>
        <div class="col-md-3">
            <label asp-for="Beds" class="form-label"></label>
            <input asp-for="Beds" class="form-control" type="number" min="0" placeholder="2" />
        </div>
        <div class="col-md-3">
            <label asp-for="Bathrooms" class="form-label"></label>
            <input asp-for="Bathrooms" class="form-control" type="number" min="0" placeholder="1" />
        </div>
    </div>

    @if (Model.ExistingImages.Any())
    {
        <div class="mt-4">
            <span class="form-label d-block">Current photos</span>
            <div class="sh-thumbrow">
                @foreach (var image in Model.ExistingImages)
                {
                    <img src="@image.ImageUrl" alt="" />
                }
            </div>
        </div>
    }

    <div class="mt-4">
        <label asp-for="Images" class="form-label"></label>
        <div class="sh-dropzone" data-sh-dropzone>
            <input asp-for="Images" class="sh-dropzone-input" type="file" multiple accept="image/*" data-sh-dropzone-input />
            <div class="sh-dropzone-surface" data-sh-dropzone-surface>
                <p class="sh-dropzone-copy">Drag photos here, or</p>
                <button type="button" class="sh-btn sh-btn-ghost" data-sh-dropzone-trigger>Choose photos</button>
                <p class="sh-dropzone-hint">Optional. New photos are appended to the existing gallery. JPG, PNG, WEBP, or GIF up to 5 MB each.</p>
            </div>
            <ul class="sh-dropzone-previews" data-sh-dropzone-previews hidden></ul>
        </div>
        <span asp-validation-for="Images" class="text-danger"></span>
    </div>

    <button class="sh-btn sh-btn-primary mt-4" type="submit">Save changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
