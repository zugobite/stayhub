@model IEnumerable<Booking>
@{
    ViewData["Title"] = "Booking Requests";
}

<div class="sh-shell">
    <partial name="_HostSidebar" />

    <section class="sh-shell-main">
        <h1 class="sh-section-title">Booking Requests</h1>

        @if (!Model.Any())
        {
            <partial name="_EmptyState" model='new EmptyState("empty-bookings", "No booking requests", "When a guest requests one of your listings, it lands here for approval.")' />
        }
        else
        {
            <div class="table-responsive">
                <table class="table sh-table align-middle">
                    <thead>
                        <tr>
                            <th>Guest</th>
                            <th>Property</th>
                            <th>Dates</th>
                            <th>Guests</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr>
                                <td>
                                    @booking.Guest?.FullName
                                    <div class="small text-muted">@booking.Guest?.Email</div>
                                </td>
                                <td>@booking.Property?.Title</td>
                                <td>@booking.CheckInDate.ToString("d MMM") – @booking.CheckOutDate.ToString("d MMM yyyy")</td>
                                <td>@booking.NumberOfGuests</td>
                                <td>R @booking.TotalPrice.ToString("N2")</td>
                                <td><span class="sh-pill sh-pill-@booking.Status.ToString().ToLowerInvariant()">@booking.Status</span></td>
                                <td>
                                    @{
                                        var actions = new List<ActionMenuItem>();

                                        if (!string.IsNullOrEmpty(booking.GuestId))
                                        {
                                            actions.Add(new ActionMenuItem(
                                                "Message Guest",
                                                Icon: "mail",
                                                Href: Url.Action("Conversation", "Messages", new { id = booking.GuestId })));
                                        }

                                        if (booking.Status == BookingStatus.Pending)
                                        {
                                            actions.Add(new ActionMenuItem(
                                                "Approve",
                                                Icon: "check",
                                                Controller: "Host",
                                                Action: "ApproveBooking",
                                                HiddenFields: new Dictionary<string, string> { ["id"] = booking.Id.ToString() }));
                                            actions.Add(new ActionMenuItem(
                                                "Reject",
                                                Icon: "x",
                                                Controller: "Host",
                                                Action: "RejectBooking",
                                                HiddenFields: new Dictionary<string, string> { ["id"] = booking.Id.ToString() },
                                                Danger: true));
                                        }
                                    }
                                    <partial name="_ActionMenu" model="actions" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
