@model LegalPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="sh-legal">
    <div class="sh-pagehead">
        <div>
            <h1>@Model.Title</h1>
            <p>@Model.Intro</p>
        </div>
    </div>

    <div class="sh-legal-body">
        @foreach (var block in Model.Sections)
        {
            <section class="sh-legal-section">
                <h2>@block.Heading</h2>
                <p>@block.Body</p>
            </section>
        }
    </div>
</div>
