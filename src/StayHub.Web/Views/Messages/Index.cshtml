@model InboxViewModel
@{
    ViewData["Title"] = "Inbox";
    var threadCount = Model.Threads.Count();
    var sentCount = Model.Sent.Count();
}

<div class="sh-pagehead">
    <div>
        <h1>
            Inbox
            @if (Model.UnreadCount > 0)
            {
                <span class="sh-badge-inline">@Model.UnreadCount unread</span>
            }
        </h1>
        <p>Messages with hosts, guests, and StayHub admins.</p>
    </div>
</div>

<div class="sh-filterbar" role="tablist" aria-label="Inbox folders">
    <button class="sh-filtertab active"
            id="tab-conversations"
            data-bs-toggle="tab"
            data-bs-target="#received"
            type="button"
            role="tab"
            aria-controls="received"
            aria-selected="true">
        <span class="sh-filtertab-label">Conversations</span><span class="sh-filtertab-count">@threadCount</span>
    </button>
    <button class="sh-filtertab"
            id="tab-sent"
            data-bs-toggle="tab"
            data-bs-target="#sent"
            type="button"
            role="tab"
            aria-controls="sent"
            aria-selected="false">
        <span class="sh-filtertab-label">Sent</span><span class="sh-filtertab-count">@sentCount</span>
    </button>
</div>

<div class="sh-inbox">
    <div class="tab-content">
        <div class="tab-pane fade show active" id="received" role="tabpanel" aria-labelledby="tab-conversations">
            @if (!Model.Threads.Any())
            {
                <partial name="_EmptyState" model='new EmptyState("empty-messages", "Your inbox is empty", "Messages from hosts, guests, and administrators arrive here.")' />
            }
            else
            {
                <div class="sh-messagelist">
                    @foreach (var thread in Model.Threads)
                    {
                        var initial = string.IsNullOrWhiteSpace(thread.OtherUserName)
                            ? "?"
                            : thread.OtherUserName.Trim()[0].ToString().ToUpperInvariant();

                        <a class="sh-message @(thread.UnreadCount > 0 ? "unread" : "")"
                           asp-action="Conversation"
                           asp-route-id="@thread.OtherUserId">
                            <span class="sh-message-avatar" aria-hidden="true">@initial</span>
                            <span class="sh-message-body">
                                <span class="sh-message-top">
                                    <span class="sh-message-name">@thread.OtherUserName</span>
                                    <span class="sh-message-time">@TimeDisplay.FormatWhen(thread.LastTimestamp)</span>
                                </span>
                                <span class="sh-message-preview">@thread.Preview</span>
                            </span>
                            @if (thread.UnreadCount > 0)
                            {
                                <span class="sh-message-count" aria-label="@thread.UnreadCount unread">@thread.UnreadCount</span>
                            }
                        </a>
                    }
                </div>
            }
        </div>

        <div class="tab-pane fade" id="sent" role="tabpanel" aria-labelledby="tab-sent">
            @if (!Model.Sent.Any())
            {
                <partial name="_EmptyState" model='new EmptyState("empty-messages", "Nothing sent yet", "Messages you send appear here.")' />
            }
            else
            {
                <div class="sh-messagelist">
                    @foreach (var message in Model.Sent)
                    {
                        var name = message.Receiver?.FullName ?? "Unknown";
                        var initial = string.IsNullOrWhiteSpace(name)
                            ? "?"
                            : name.Trim()[0].ToString().ToUpperInvariant();

                        <a class="sh-message"
                           asp-action="Conversation"
                           asp-route-id="@message.ReceiverId">
                            <span class="sh-message-avatar" aria-hidden="true">@initial</span>
                            <span class="sh-message-body">
                                <span class="sh-message-top">
                                    <span class="sh-message-name">To @name</span>
                                    <span class="sh-message-time">@TimeDisplay.FormatWhen(message.Timestamp)</span>
                                </span>
                                <span class="sh-message-preview">@message.Content</span>
                            </span>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.sh-filterbar [data-bs-toggle="tab"]').forEach(function (tab) {
            tab.addEventListener('shown.bs.tab', function (event) {
                document.querySelectorAll('.sh-filterbar [data-bs-toggle="tab"]').forEach(function (el) {
                    el.classList.toggle('active', el === event.target);
                    el.setAttribute('aria-selected', el === event.target ? 'true' : 'false');
                });
            });
        });
    </script>
}
