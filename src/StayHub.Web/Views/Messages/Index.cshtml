@model InboxViewModel
@{
    ViewData["Title"] = "Inbox";
}

<h1 class="sh-section-title">Inbox @if (Model.UnreadCount > 0) { <span class="sh-badge-inline">@Model.UnreadCount unread</span> }</h1>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#received" type="button">Conversations</button></li>
    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#sent" type="button">Sent</button></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="received">
        @if (!Model.Threads.Any())
        {
            <partial name="_EmptyState" model='new EmptyState("empty-messages", "Your inbox is empty", "Messages from hosts, guests, and administrators arrive here.")' />
        }
        else
        {
            foreach (var thread in Model.Threads)
            {
                <a class="sh-message @(thread.UnreadCount > 0 ? "unread" : "")"
                   asp-action="Conversation" asp-route-id="@thread.OtherUserId">
                    <div class="d-flex justify-content-between">
                        <strong>@thread.OtherUserName</strong>
                        <span class="text-muted small">@thread.LastTimestamp.ToString("d MMM HH:mm")</span>
                    </div>
                    <div class="d-flex justify-content-between gap-2">
                        <div class="text-muted text-truncate">@thread.Preview</div>
                        @if (thread.UnreadCount > 0)
                        {
                            <span class="sh-badge-inline">@thread.UnreadCount</span>
                        }
                    </div>
                </a>
            }
        }
    </div>

    <div class="tab-pane fade" id="sent">
        @if (!Model.Sent.Any())
        {
            <partial name="_EmptyState" model='new EmptyState("empty-messages", "Nothing sent yet", "Messages you send appear here.")' />
        }
        else
        {
            foreach (var message in Model.Sent)
            {
                <a class="sh-message" asp-action="Conversation" asp-route-id="@message.ReceiverId">
                    <div class="d-flex justify-content-between">
                        <strong>To @message.Receiver?.FullName</strong>
                        <span class="text-muted small">@message.Timestamp.ToString("d MMM HH:mm")</span>
                    </div>
                    <div class="text-muted">@message.Content</div>
                </a>
            }
        }
    </div>
</div>
