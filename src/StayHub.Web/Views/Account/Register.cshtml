@model RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
}

<div class="sh-authcard">
    <h1 class="sh-section-title">Create an Account</h1>
    <p class="text-muted">You will join as a Guest. Apply to become a Host at any time.</p>

    <form asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" placeholder="@Html.DisplayNameFor(m => m.FirstName)" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" placeholder="@Html.DisplayNameFor(m => m.LastName)" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" autocomplete="username" placeholder="@Html.DisplayNameFor(m => m.Email)" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <label asp-for="Password" class="form-label"></label>
            <div class="sh-password-field">
                <input asp-for="Password" class="form-control" autocomplete="new-password" placeholder="@Html.DisplayNameFor(m => m.Password)" />
                <partial name="_PasswordToggleButton" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mt-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <div class="sh-password-field">
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="@Html.DisplayNameFor(m => m.ConfirmPassword)" />
                <partial name="_PasswordToggleButton" />
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="sh-btn sh-btn-primary w-100 mt-4">Sign Up</button>
    </form>

    <p class="mt-3 mb-0 text-center">
        Already have an account? <a asp-action="Login">Log In</a>
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
