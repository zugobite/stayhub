@model IEnumerable<HostApplication>
@{
    ViewData["Title"] = "Host requests";
    var selected = ViewBag.Status as ApplicationStatus?;
}

<div class="sh-shell">
    <partial name="_AdminSidebar" />

    <section class="sh-shell-main">
        <h1 class="sh-section-title">Host requests</h1>

        <div class="sh-filterbar">
            <a class="sh-filtertab @(selected == ApplicationStatus.Pending ? "active" : "")" asp-action="HostRequests" asp-route-status="@ApplicationStatus.Pending">PENDING</a>
            <a class="sh-filtertab @(selected == ApplicationStatus.Approved ? "active" : "")" asp-action="HostRequests" asp-route-status="@ApplicationStatus.Approved">APPROVED</a>
            <a class="sh-filtertab @(selected == ApplicationStatus.Rejected ? "active" : "")" asp-action="HostRequests" asp-route-status="@ApplicationStatus.Rejected">REJECTED</a>
            <a class="sh-filtertab @(selected is null ? "active" : "")" asp-action="HostRequests">ALL</a>
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted mt-3">No applications match this filter.</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table sh-table align-middle">
                    <thead><tr><th>Applicant</th><th>Property</th><th>Type</th><th>Submitted</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                    <tbody>
                        @foreach (var application in Model)
                        {
                            <tr>
                                <td>
                                    @application.ApplicationUser?.FullName
                                    <div class="small text-muted">@application.ApplicationUser?.Email</div>
                                </td>
                                <td>@application.Property?.Title</td>
                                <td>@(application.IsAdditionalProperty ? "Additional" : "Initial")</td>
                                <td>@application.AppliedAt.ToString("d MMM yyyy")</td>
                                <td><span class="sh-pill sh-pill-@application.Status.ToString().ToLowerInvariant()">@application.Status</span></td>
                                <td class="text-end">
                                    <partial name="_ActionMenu" model='new List<ActionMenuItem>
                                    {
                                        new("Review", Href: Url.Action("ReviewApplication", new { id = application.Id }))
                                    }' />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
