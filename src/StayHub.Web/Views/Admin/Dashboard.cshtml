@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var needsAttention = Model.PendingApplications + Model.PendingBookings;
}

<div class="sh-shell">
    <partial name="_AdminSidebar" />

    <section class="sh-shell-main">
        <div class="sh-welcome">
            <span class="sh-eyebrow">Platform overview</span>
            <h1>Admin Dashboard</h1>
            <p>
                @if (needsAttention > 0)
                {
                    @($"{needsAttention} item(s) need attention across applications and bookings.")
                }
                else
                {
                    @("Everything is up to date - no applications or bookings are waiting.")
                }
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a class="sh-btn sh-btn-sun sh-btn-sm" asp-action="HostRequests">Review host requests</a>
                <a class="sh-btn sh-btn-ghost sh-btn-sm" asp-action="Users">Manage users</a>
                <a class="sh-btn sh-btn-ghost sh-btn-sm" asp-action="ActivityLogs">Activity Logs</a>
            </div>
        </div>

        <div class="sh-statgrid sh-statgrid-4">
            <partial name="_StatCard" model='new StatCard("Total Users", Model.TotalUsers.ToString(), "Registered accounts", "users")' />
            <partial name="_StatCard" model='new StatCard("Pending Host Apps", Model.PendingApplications.ToString(), "Require review", "document", "sun")' />
            <partial name="_StatCard" model='new StatCard("Active Properties", Model.ActiveProperties.ToString(), "Listings available", "home")' />
            <partial name="_StatCard" model='new StatCard("Platform Revenue", $"R {Model.PlatformRevenue:N0}", "Total earnings", "wallet", "leaf")' />
            <partial name="_StatCard" model='new StatCard("Total Bookings", Model.TotalBookings.ToString(), $"{Model.PendingBookings} pending", "calendar")' />
            <partial name="_StatCard" model='new StatCard("Approved Hosts", Model.ApprovedHosts.ToString(), "Active hosts", "usercheck", "leaf")' />
        </div>

        <div class="sh-panel mt-4">
            <div class="sh-panel-head">
                <h2>Recent Host Applications</h2>
                <a class="sh-linkarrow" asp-action="HostRequests">View all</a>
            </div>
            <div class="sh-panel-body">
                @if (!Model.RecentApplications.Any())
                {
                    <div class="sh-empty">
                        <div class="sh-empty-title">No applications yet</div>
                        <p>When a guest applies to list a property, it will appear here for review.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table sh-table align-middle">
                            <thead><tr><th>Applicant</th><th>Property</th><th>Date</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
                            <tbody>
                                @foreach (var application in Model.RecentApplications)
                                {
                                    <tr>
                                        <td>@application.ApplicationUser?.FullName</td>
                                        <td>@application.Property?.Title</td>
                                        <td>@application.AppliedAt.ToString("d MMM yyyy")</td>
                                        <td><span class="sh-pill sh-pill-@application.Status.ToString().ToLowerInvariant()">@application.Status</span></td>
                                        <td class="text-end"><partial name="_ActionMenu" model='new List<ActionMenuItem> { new("Review", Icon: "document", Href: Url.Action("ReviewApplication", new { id = application.Id })) }' /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="sh-panel mt-4">
            <div class="sh-panel-head">
                <h2>Recent Bookings</h2>
                <a class="sh-linkarrow" asp-action="Bookings">View all</a>
            </div>
            <div class="sh-panel-body">
                @if (!Model.RecentBookings.Any())
                {
                    <div class="sh-empty">
                        <div class="sh-empty-title">No bookings yet</div>
                        <p>Reservations made by guests will be listed here.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table sh-table align-middle">
                            <thead><tr><th>Guest</th><th>Property</th><th>Dates</th><th>Status</th><th class="text-end">Amount</th><th class="text-end">Actions</th></tr></thead>
                            <tbody>
                                @foreach (var booking in Model.RecentBookings)
                                {
                                    <tr>
                                        <td>@booking.Guest?.FullName</td>
                                        <td>@booking.Property?.Title</td>
                                        <td>@booking.CheckInDate.ToString("d MMM") – @booking.CheckOutDate.ToString("d MMM yyyy")</td>
                                        <td><span class="sh-pill sh-pill-@booking.Status.ToString().ToLowerInvariant()">@booking.Status</span></td>
                                        <td class="text-end fw-semibold">R @booking.TotalPrice.ToString("N2")</td>
                                        <td class="text-end">
                                            <partial name="_ActionMenu" model='new List<ActionMenuItem>
                                            {
                                                new("View Property", Icon: "eye", Href: Url.Action("View", "Properties", new { id = booking.PropertyId }))
                                            }' />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="sh-panel mt-4">
            <div class="sh-panel-head">
                <h2>Recent Activity</h2>
                <a class="sh-linkarrow" asp-action="ActivityLogs">View all</a>
            </div>
            <div class="sh-panel-body">
                @if (!Model.RecentActivity.Any())
                {
                    <div class="sh-empty">
                        <div class="sh-empty-title">Nothing logged yet</div>
                        <p>Audit-trail entries are recorded as users act on the platform.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table sh-table align-middle">
                            <thead><tr><th>User</th><th>Action</th><th>When</th></tr></thead>
                            <tbody>
                                @foreach (var entry in Model.RecentActivity)
                                {
                                    <tr>
                                        <td>
                                            @entry.User?.FullName
                                            <div class="small text-muted">@entry.User?.Email</div>
                                        </td>
                                        <td>
                                            @entry.Action
                                            <div class="mt-1"><span class="sh-tag">@entry.ActivityType</span></div>
                                        </td>
                                        <td class="text-nowrap">@entry.CreatedAt.ToString("d MMM, HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </section>
</div>
