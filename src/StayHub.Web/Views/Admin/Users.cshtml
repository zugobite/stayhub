@model UserManagementViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="sh-shell">
    <partial name="_AdminSidebar" />

    <section class="sh-shell-main">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h1 class="sh-section-title mb-0">Users</h1>
            <form method="get" class="d-flex gap-2">
                <input name="search" class="form-control" placeholder="Search" value="@Model.SearchTerm" />
                <button class="sh-btn sh-btn-primary" type="submit">Search</button>
            </form>
        </div>

        @if (!Model.CanPromote)
        {
            <p class="text-muted">Only the SuperAdmin can promote a Guest to the Admin role.</p>
        }

        <div class="table-responsive">
            <table class="table sh-table align-middle">
                <thead><tr><th>Name</th><th>Email</th><th>Roles</th><th>Registered</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var row in Model.Users)
                    {
                        <tr>
                            <td>@row.User.FullName</td>
                            <td>@row.User.Email</td>
                            <td>
                                @foreach (var role in row.Roles)
                                {
                                    <span class="sh-tag">@role</span>
                                }
                            </td>
                            <td>@row.User.CreatedAt.ToString("d MMM yyyy")</td>
                            <td class="text-end">
                                @{
                                    var actions = new List<ActionMenuItem>
                                    {
                                        new("Message", Icon: "mail", Href: Url.Action("Conversation", "Messages", new { id = row.User.Id }))
                                    };

                                    if (Model.CanPromote && row.Roles.Contains(Roles.Guest))
                                    {
                                        actions.Add(new ActionMenuItem(
                                            "Promote to Admin",
                                            Icon: "userplus",
                                            Controller: "Admin",
                                            Action: "PromoteToAdmin",
                                            HiddenFields: new Dictionary<string, string> { ["id"] = row.User.Id },
                                            ConfirmMessage: $"{row.User.FullName} ({row.User.Email}) will gain full administrative access to StayHub. This cannot be undone from the interface.",
                                            ConfirmTitle: "Promote to Admin",
                                            ConfirmAction: "Promote"));
                                    }
                                }
                                <partial name="_ActionMenu" model="actions" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
